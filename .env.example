# Copy to ~/.hue.env on the Pi (chmod 600). Get the key by pressing the bridge's
# link button, then POST {"devicetype":"rpi#raspberrypi","generateclientkey":true}
# to https://<bridge-ip>/api within 30 seconds.
HUE_BRIDGE=192.168.1.2
HUE_KEY=your-hue-application-key
HUE_CLIENTKEY=your-32-hex-char-entertainment-client-key
# Optional overrides
# HUE_AREA=Living room
# BUTTON_PORT=/dev/ttyACM0
